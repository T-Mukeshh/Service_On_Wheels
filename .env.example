# ─────────────────────────────────────────────────────────────────
# Service On Wheels — Environment Variables
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual secrets.
# The .env file is loaded automatically by Docker Compose.
# ─────────────────────────────────────────────────────────────────

# JWT Configuration
JWT_SECRET=my-super-secret-jwt-key-change-me-in-production
JWT_EXPIRATION_MS=900000

# MongoDB (only needed if overriding the default docker-compose URI)
# MONGODB_URI=mongodb://mongodb:27017/service-on-wheels

# Email / SMTP (Gmail)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Frontend URL for password-reset links
FRONTEND_RESET_URL=http://localhost/reset-password

# Logging
APP_LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────────
# Phase 5: Payment, Redis, and Observability
# ─────────────────────────────────────────────────────────────────

# Razorpay (Get test keys from dashboard.razorpay.com)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Redis (for distributed rate limiting)
# REDIS_HOST=redis
# REDIS_PORT=6379

# Sentry (for error tracking, leave blank to disable)
SENTRY_DSN=
